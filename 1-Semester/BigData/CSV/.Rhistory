head(df_map)
# 대륙별 지도
# 국가별(id)로 색상을 다르게 지정
ggplot(data = df_map,
aes(x = long, y = lat, group = group, fill = id)) + # fill = id 추가
geom_polygon(color = "#FFFFFF", size = 0.1) + # 테두리 흰색
theme_minimal() +
theme(
legend.position = "none", # 범례 제거
panel.background = element_rect(fill = "#F4F7F9", color = NA), # 연한 파란색 바다 배경
panel.grid = element_blank()
)
# 아시아 국가별 지도 시각화
ggplot(data = df_asia,
aes(x = long, y = lat, group = group, fill = id)) +
geom_polygon(color = "#FFFFFF", linewidth = 0.2) +
# RColorBrewer 패키지 : 파스텔 색상 스펙트럼 생성
scale_fill_manual(values = colorRampPalette(RColorBrewer::brewer.pal(8, "Pastel2"))(length(vec_conti))) +
theme_minimal() +
theme(
legend.position = "none",
panel.background = element_rect(fill = "#FAFAFA", color = NA),
panel.grid = element_blank(),
axis.text = element_blank(),
axis.title = element_blank()
)
# --------------------------
# 1. 전 세계 지도 시각화
ggplot(data = df_map,
aes(x = long, y = lat, group = group, fill = id)) +
geom_polygon(color = "#FFFFFF", linewidth = 0.1) +
theme_minimal() +
theme(
legend.position = "none",
panel.background = element_rect(fill = "#F4F7F9", color = NA),
panel.grid = element_blank(),
axis.text = element_blank(),  # 축 눈금 제거
axis.title = element_blank()
)
str(mtcars)
vars <- c("mpg", "disp", "wt", "cyl")
target <- mtcars[ , vars]
head(target)
par(family="AppleGothic")
pairs(target, main="연비, 배기량, 무게, 실린더 수에 따른 산포도",
col=rainbow(4))
plot(time, sales, main="광고 시간과 판매량 추이",
xlab="시간(분)", ylab="판매량(잔)", pch=22,
col="blue", bg="red", cex=1.5)
setwd("~/Study/CourseWork/Coursework/BigData/CSV")
DF <- read.csv("adv_sales.csv")
par(family="AppleGothic")
str(DF)
time <- DF$ADV
sales <- DF$Sales
plot(time, sales, main="광고 시간과 판매량 추이",
xlab="시간(분)", ylab="판매량(잔)", pch=22,
col="blue", bg="red", cex=1.5)
